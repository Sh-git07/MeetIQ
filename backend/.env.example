# MeetIQ Backend Environment Variables

# Database Connection (PostgreSQL on Supabase or local PostgreSQL)
# If left empty, the application automatically falls back to local SQLite: sqlite:///./meetiq.db
DATABASE_URL=

# Supabase Credentials (optional if using direct DATABASE_URL)
SUPABASE_URL=
SUPABASE_KEY=

# Allowed Frontend Origins (comma-separated or single URL)
FRONTEND_URL=http://localhost:5173

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
